// jrpccodec.nv — text on the wire to typed values, and back.
//
// `decode` answers a `Result`, because the text comes from a peer.
// `encode` answers text and cannot fail: the constructors in `jrpcmsg`
// refused every shape the specification forbids.
//
// `decode_or_error` is what a server's read loop is written against.
// Section 5 requires a server that could not read a request to answer
// an error response, with the request's id when it could be read and
// the null id when it could not.  `decode_or_error` makes that
// response.  It answers a `JrpcRead` rather than a `Result`, because
// its refusal is a message to send rather than an error to propagate.
//
// This module reads members out of a value `std.json` parsed.  It has
// no scanner of its own.

use std.json
use jrpcerr
use jrpcid
use jrpcmsg

// An envelope decoded from the text of one message.
//
// The text is the content of one frame, not a stream: framing is
// `jrpcframe`'s, and a caller feeding this function two concatenated
// messages gets `JrpcNotJson`, which is correct and is not the error
// it was hoping for.
//
// ```novo
// use jrpccodec
//
// fn main() [io]
//     match jrpccodec.decode("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
//         Ok(_)  => println("a notification")
//         Err(f) => println(f.message())
// ```
pub fn decode(text: Str) -> Result<jrpcmsg.JrpcEnvelope, jrpcerr.JrpcFault> []
    let Some(v) = json.parse(text) else return Err(jrpcerr.fault(JrpcNotJson, preview(text)))
    decode_value(v)

// An envelope decoded from a JSON value the caller already parsed.
//
// For a transport that hands over values rather than text — an
// in-process channel, a test harness, a peer whose framing layer
// parsed as it read.
//
// ```novo
// use std.json
// use jrpccodec
//
// fn main() [io]
//     match json.parse("{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}")
//         None    => println("not json")
//         Some(v) =>
//             match jrpccodec.decode_value(v)
//                 Ok(_)  => println("decoded")
//                 Err(f) => println(f.message())
// ```
pub fn decode_value(v: JsonValueH) -> Result<jrpcmsg.JrpcEnvelope, jrpcerr.JrpcFault> []
    if json.type_of(v) != "array"
        return Ok(JrpcSingle(message: decode_message(v)!))
    let n = json.len(v) ?? 0
    if n == 0
        return Err(jrpcerr.fault(JrpcEmptyBatch, "[]"))
    var messages: [jrpcmsg.JrpcMessage] = []
    for i in 0..n
        let item = json.index(v, i) ?? json.null()
        match decode_message(item)
            Ok(m)  => list.push(messages, m)
            Err(f) =>
                return Err(jrpcerr.fault(f.kind, "batch member ${i}: ${f.detail}"))
    Ok(JrpcBatch(messages: messages))

// One message decoded from one JSON object.
//
// The arm is decided by the members present, which is what section 4
// and section 5 say rather than what an implementation might prefer: a
// `method` member makes it a request, and a `result` or an `error`
// member makes it a response.  An object with neither is `JrpcNoOutcome`
// and an object with `method` and `result` is a request, because
// section 4 lists no member the server may not also have invented.
//
// ```novo
// use std.json
// use jrpccodec
//
// fn main() [io]
//     match json.parse("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}")
//         None    => println("not json")
//         Some(v) =>
//             match jrpccodec.decode_message(v)
//                 Ok(_)  => println("a response")
//                 Err(f) => println(f.message())
// ```
pub fn decode_message(v: JsonValueH) -> Result<jrpcmsg.JrpcMessage, jrpcerr.JrpcFault> []
    if json.type_of(v) != "object"
        return Err(jrpcerr.fault(JrpcNotObject, json.type_of(v)))
    let version = json.get(v, "jsonrpc")
    if json.get_str(v, "jsonrpc") != Some("2.0")
        let seen = if version == None
            "no jsonrpc member"
        else
            json.stringify(version ?? json.null())
        return Err(jrpcerr.fault(JrpcBadVersion, seen))
    if json.get(v, "method") != None
        return Ok(JrpcRequestMsg(request: decode_request(v)!))
    Ok(JrpcResponseMsg(response: decode_response(v)!))

// What a read produced: the envelope, or the refusal to send instead.
//
// `decode_or_error`'s answer, and the reason that function is not a
// `Result`.  The second arm is not a failure — it is a message, the
// error response section 5 obliges the server to send, already built —
// and an `Err` holding a value the caller transmits reads as the
// opposite of what happened.
//
// The refusal carries the fault as well as the response, because the
// two answer different questions and a server needs both: the
// response is what to send, and the fault is whether to send it at
// all — `jrpcerr.is_framing_fault` on its kind is what says to close
// the connection instead, and a caller holding only the response
// cannot ask.
//
// ```novo
// use jrpccodec
//
// fn main() [io]
//     match jrpccodec.decode_or_error("not json at all")
//         JrpcReadEnvelope(e)   => println(jrpccodec.encode(e))
//         JrpcReadRefusal(r, _) => println(jrpccodec.encode_response(r))
//         JrpcReadMixed(ms, rs) => println("${ms.len()} to answer, ${rs.len()} refused")
// ```
pub enum JrpcRead
    // The text decoded, and there is nothing to send.
    JrpcReadEnvelope(envelope: jrpcmsg.JrpcEnvelope)
    // The text did not decode.  `response` is what section 5 requires
    // the server to send: the error `jrpcerr.error_for_fault` maps the
    // fault to, under the request's id when it could be read and the
    // null id when it could not.  `fault` is why, for the log and for
    // `jrpcerr.is_framing_fault`.
    JrpcReadRefusal(response: jrpcmsg.JrpcResponse, fault: jrpcerr.JrpcFault)
    // A batch some of whose members did not decode.  `messages` are the
    // members that did, to be dispatched as usual, and `refusals` are
    // the error responses for the others, which go into the batch's
    // response array beside the answers (section 6).
    JrpcReadMixed(messages: [jrpcmsg.JrpcMessage], refusals: [jrpcmsg.JrpcResponse])

// The envelope, or the responses a server must send for what it could
// not read.
//
// This is the function a server's read loop is written against.  The
// fault is mapped by `jrpcerr.error_for_fault`, and the response
// carries the request's id when it could be read and the null id when
// it could not (section 5).  A batch whose members are all well formed
// is an envelope; a batch with members that are not answers
// `JrpcReadMixed`, the good members to dispatch and a refusal for each
// of the others (section 6).
//
// A framing fault is answered here too, so the caller can log a
// response it will not send.  `jrpcerr.is_framing_fault` on the
// refusal's fault says to close the connection instead.
//
// ```novo
// use jrpcerr
// use jrpccodec
//
// fn main() [io]
//     match jrpccodec.decode_or_error("not json at all")
//         JrpcReadEnvelope(e)   => println(jrpccodec.encode(e))
//         JrpcReadRefusal(r, f) =>
//             if jrpcerr.is_framing_fault(f.kind)
//                 println("out of step; close")
//             else
//                 println(jrpccodec.encode_response(r))
//         JrpcReadMixed(ms, rs) => println("${ms.len()} to answer, ${rs.len()} refused")
// ```
pub fn decode_or_error(text: Str) -> JrpcRead []
    match decode(text)
        Ok(e)  => JrpcReadEnvelope(envelope: e)
        Err(f) =>
            if let Some(v) = json.parse(text)
                if json.type_of(v) == "array" and (json.len(v) ?? 0) > 0
                    return members_of(v)
            let reply = jrpcmsg.failed(id_of(text), jrpcerr.error_for_fault(f))
            JrpcReadRefusal(response: reply, fault: f)

// The envelope as the text of one message.
//
// A `JrpcSingle` encodes as an object and a `JrpcBatch` as an array,
// which is section 6's distinction and the reason the two are separate
// arms rather than a list of length one.
//
// ```novo
// use jrpcmsg
// use jrpccodec
//
// fn main() [io]
//     let e = jrpcmsg.single(JrpcRequestMsg(jrpcmsg.notification("exit", None)))
//     println(jrpccodec.encode(e))
// ```
pub fn encode(e: jrpcmsg.JrpcEnvelope) -> Str []
    json.stringify(envelope_to_json(e))

// One message as text.
//
// ```novo
// use jrpcmsg
// use jrpccodec
//
// fn main() [io]
//     println(jrpccodec.encode_message(
//         JrpcRequestMsg(jrpcmsg.notification("exit", None))))
// ```
pub fn encode_message(m: jrpcmsg.JrpcMessage) -> Str []
    json.stringify(message_to_json(m))

// One request as text.
//
// ```novo
// use jrpcmsg
// use jrpccodec
//
// fn main() [io]
//     println(jrpccodec.encode_request(jrpcmsg.call(JrpcIdInt(1), "initialize", None)))
// ```
pub fn encode_request(r: jrpcmsg.JrpcRequest) -> Str []
    encode_message(JrpcRequestMsg(request: r))

// One response as text.
//
// ```novo
// use std.json
// use jrpcmsg
// use jrpccodec
//
// fn main() [io]
//     println(jrpccodec.encode_response(jrpcmsg.ok(JrpcIdInt(1), json.null())))
// ```
pub fn encode_response(r: jrpcmsg.JrpcResponse) -> Str []
    encode_message(JrpcResponseMsg(response: r))

// A message as a JSON value, for a caller that will embed it in
// something else or compare it structurally.
//
// The member order is the specification's reading order — `jsonrpc`,
// then `id`, then `method` and `params` or `result` and `error` —
// because a person reading a log of these reads the version and the id
// first.  Member order is not part of a JSON object's identity, so
// nothing depends on it; it is a courtesy to whoever has to read the
// bytes.
//
// ```novo
// use std.json
// use jrpcmsg
// use jrpccodec
//
// fn main() [io]
//     println(json.stringify(jrpccodec.message_to_json(
//         JrpcRequestMsg(jrpcmsg.notification("exit", None)))))
// ```
pub fn message_to_json(m: jrpcmsg.JrpcMessage) -> JsonValueH []
    match m
        JrpcRequestMsg(r)  => request_to_json(r)
        JrpcResponseMsg(r) => response_to_json(r)

// An envelope as a JSON value.
//
// ```novo
// use std.json
// use jrpcmsg
// use jrpccodec
//
// fn main() [io]
//     let e = jrpcmsg.single(JrpcRequestMsg(jrpcmsg.notification("exit", None)))
//     println(json.stringify(jrpccodec.envelope_to_json(e)))
// ```
pub fn envelope_to_json(e: jrpcmsg.JrpcEnvelope) -> JsonValueH []
    match e
        JrpcSingle(m) => message_to_json(m)
        JrpcBatch(ms) =>
            var items: [JsonValueH] = []
            for m in ms
                list.push(items, message_to_json(m))
            json.array(items)

// The response array a server sends for a batch, or `None` when it
// must send nothing.
//
// Section 6's rule, applied: the responses the server produced go in
// an array, and an empty set of responses is not an empty array but no
// message at all.  `None` is that "nothing", and it is a different
// thing from `Some("[]")` — a client reading `[]` has been told its
// batch produced results, which it did not.
//
// ```novo
// use jrpccodec
//
// fn main() [io]
//     match jrpccodec.encode_batch_replies([])
//         None    => println("send nothing")
//         Some(t) => println(t)
// ```
pub fn encode_batch_replies(replies: [jrpcmsg.JrpcResponse]) -> ?Str []
    if list.len(replies) == 0
        return None
    var items: [JsonValueH] = []
    for r in replies
        list.push(items, response_to_json(r))
    Some(json.stringify(json.array(items)))

// ── the members of one message ───────────────────────────────────────

// The first 64 bytes of a text, for a fault's detail.
fn preview(text: Str) -> Str
    if str.len(text) <= 64
        return text
    str.slice(text, 0, 64) + "..."

fn decode_request(v: JsonValueH) -> Result<jrpcmsg.JrpcRequest, jrpcerr.JrpcFault>
    let Some(method) = json.get_str(v, "method") else return Err(jrpcerr.fault(JrpcNoMethod, json.stringify(json.get(v, "method") ?? json.null())))
    let params = json.get(v, "params")
    if let Some(p) = params
        if not jrpcmsg.params_ok(p)
            return Err(jrpcerr.fault(JrpcBadParams, json.type_of(p)))
    let Some(raw) = json.get(v, "id") else return Ok(jrpcmsg.notification(method, params))
    Ok(jrpcmsg.call(jrpcid.id_from_json(raw)!, method, params))

fn decode_response(v: JsonValueH) -> Result<jrpcmsg.JrpcResponse, jrpcerr.JrpcFault>
    let result = json.get(v, "result")
    let error = json.get(v, "error")
    if result != None and error != None
        return Err(jrpcerr.fault(JrpcBothOutcomes, "result and error"))
    if result == None and error == None
        return Err(jrpcerr.fault(JrpcNoOutcome, "no method, result or error"))
    let Some(raw) = json.get(v, "id") else return Err(jrpcerr.fault(JrpcBadId, "a response with no id"))
    let id = jrpcid.id_from_json(raw)!
    let Some(e) = error else return Ok(jrpcmsg.ok(id, result ?? json.null()))
    Ok(jrpcmsg.failed(id, jrpcerr.error_from_json(e)!))

// The id of a request that did not decode, when the text is an object
// whose `id` member is one: section 5 answers such a request with its
// own id, and with the null id only when the id cannot be read.
fn id_of(text: Str) -> JrpcId
    let Some(v) = json.parse(text) else return JrpcIdNull
    if json.type_of(v) != "object"
        return JrpcIdNull
    id_in(v)

// A batch read member by member: each one that decodes, and a refusal
// for each one that does not, under its own id when it has one.
fn members_of(v: JsonValueH) -> JrpcRead
    var messages: [jrpcmsg.JrpcMessage] = []
    var refusals: [jrpcmsg.JrpcResponse] = []
    for i in 0..(json.len(v) ?? 0)
        let item = json.index(v, i) ?? json.null()
        let read = decode_message(item)
        if let Ok(m) = read
            list.push(messages, m)
        if let Err(f) = read
            list.push(refusals, jrpcmsg.failed(id_in(item), jrpcerr.error_for_fault(f)))
    JrpcReadMixed(messages: messages, refusals: refusals)

// The id of an object whose `id` member is one, or the null id.
fn id_in(v: JsonValueH) -> JrpcId
    let Some(raw) = json.get(v, "id") else return JrpcIdNull
    match jrpcid.id_from_json(raw)
        Ok(i)  => i
        Err(_) => JrpcIdNull

fn request_to_json(r: jrpcmsg.JrpcRequest) -> JsonValueH
    var members: [(Str, JsonValueH)] = [("jsonrpc", json.string(jrpcmsg.version()))]
    if let Some(i) = r.id
        list.push(members, ("id", jrpcid.id_to_json(i)))
    list.push(members, ("method", json.string(r.method)))
    if let Some(p) = r.params
        list.push(members, ("params", p))
    json.object(members)

fn response_to_json(r: jrpcmsg.JrpcResponse) -> JsonValueH
    let outcome = match r.outcome
        JrpcResult(v)  => ("result", v)
        JrpcFailure(e) => ("error", jrpcerr.error_to_json(e))
    json.object([("jsonrpc", json.string(jrpcmsg.version())), ("id", jrpcid.id_to_json(r.id)), outcome])
